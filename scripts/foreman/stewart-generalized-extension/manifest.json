{
  "manifest_version": 3,
  "name": "PookaKind Stewart Generalized Credential Bridge",
  "version": "0.2.0",
  "key": "",
  "description": "Inactive exact one-operation background credential bridge.",
  "permissions": ["nativeMessaging"],
  "host_permissions": ["https://*/*"],
  "background": {
    "service_worker": "service-worker.js"
  },
  "content_scripts": [
    {
      "matches": ["https://*/*"],
      "js": ["content-runtime.js", "content-script.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
