# Set to 1 on Sally to mock sign-in/checkout in dev (no Supabase/Stripe required).
# Set to 0 to require real Supabase/Stripe wiring on localhost.
NEXT_PUBLIC_LOCAL_ROUTE_PREVIEW=1

# Bellows intake submit boundary (see lib/squibb/concierge-intake-availability.ts).
# Local/dev: open by default. Production: leave unset/false until Operator phrase
# APPROVE OPEN BELLOWS INTAKE SUBMISSION ON WERKLES.COM — then set both to true on Vercel.
# NEXT_PUBLIC_BELLOWS_INTAKE_SUBMISSION_OPEN=false
# BELLOWS_INTAKE_SUBMISSION_OPEN=false
# Local next start only — never set on Vercel Production (hard-blocked in code):
# BELLOWS_PERSONAL_RECS_LOCAL=true
# GHOST_FLEET_LOCAL=true
# Opens member surfaces without sign-in for the Ghost Fleet walkthrough. Local/Preview only:
# NEXT_PUBLIC_GHOST_FLEET_UI=1

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-public-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-vercel-server-side-secret
CRON_SECRET=replace-with-random-cron-secret
STRIPE_SECRET_KEY=sk_test_replace-with-stripe-secret
STRIPE_WEBHOOK_SECRET=whsec_replace-with-webhook-secret
STRIPE_MONTHLY_PRICE_ID=price_replace-with-monthly-foundry-dues
STRIPE_YEARLY_PRICE_ID=price_replace-with-yearly-foundry-dues
